<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#071427"><meta name="description" content="TIDEBREAK — a free, shimmering ocean arena survival game. Move, fight waves, and upgrade your hero.">
<title>TIDEBREAK ✦ Neon Tides</title>
<style>
/* ONE-FILE DEPLOYMENT: everything in this document runs locally in a browser, without assets or a server. */
:root{color-scheme:dark;--ink:#e9fbff;--muted:#9ac7d9;--cyan:#55f6ff;--gold:#ffd67e;--panel:rgba(7,19,41,.86)}
*{box-sizing:border-box}html,body{height:100%;margin:0;overflow:hidden;background:#030a19;color:var(--ink);font-family:system-ui,-apple-system,Segoe UI,Arial,sans-serif;touch-action:none}button{font:inherit;cursor:pointer}button:focus-visible{outline:3px solid #fff;outline-offset:3px}
#game{display:block;width:100vw;height:100dvh;touch-action:none;cursor:crosshair}
/* A subtle atmospheric layer sits OVER canvas but never intercepts game input. */
#glow{position:fixed;inset:0;pointer-events:none;z-index:1;background:radial-gradient(ellipse at 50% 35%,transparent 38%,rgba(2,5,20,.37) 100%)}
#hud{z-index:3;position:fixed;top:max(12px,env(safe-area-inset-top));left:max(12px,env(safe-area-inset-left));right:max(12px,env(safe-area-inset-right));display:none;align-items:flex-start;justify-content:space-between;gap:12px;pointer-events:none}
.hud-card{padding:10px 14px;border:1px solid rgba(143,226,255,.24);background:rgba(4,15,35,.75);border-radius:15px;box-shadow:0 8px 35px #01071075;backdrop-filter:blur(12px)}.hud-name{font-size:10px;letter-spacing:.24em;color:#84eaff;font-weight:800}.hud-title{font-size:14px;font-weight:900;letter-spacing:.04em;white-space:nowrap}.stats{display:flex;align-items:center;gap:12px;font-size:12px;font-weight:750}.stat span{color:var(--gold)}
.meter{height:7px;background:#19304b;border-radius:99px;overflow:hidden;margin-top:6px;width:190px}.meter>div{height:100%;width:100%;background:linear-gradient(90deg,#ff548d,#ff9b91);border-radius:99px;transition:width .13s}.xp-meter{height:3px;margin-top:5px}.xp-meter>div{background:linear-gradient(90deg,#51e9ff,#ae89ff)}
#pauseBtn{pointer-events:auto;background:rgba(6,22,45,.84);color:white;border:1px solid #6aabc35b;border-radius:12px;width:44px;height:44px;font-size:18px;box-shadow:0 0 24px #00d7ff18}
#combo{position:fixed;top:105px;right:20px;z-index:3;font-size:13px;font-weight:900;color:#ffdd8c;text-shadow:0 0 12px #ffbc60;pointer-events:none}
/* Menus have pointer events. Game beneath continues animating on the start screen. */
.screen{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:22px;z-index:7;background:linear-gradient(180deg,rgba(1,6,20,.50),rgba(2,10,25,.73));overflow:auto}.screen.hidden{display:none}
.panel{width:min(550px,100%);max-height:min(92dvh,900px);overflow:auto;text-align:center;background:linear-gradient(145deg,rgba(11,32,60,.96),rgba(4,12,32,.96));border:1px solid rgba(110,238,255,.38);border-radius:26px;box-shadow:0 0 0 1px #011c31,0 0 95px #10dfff27,0 35px 90px #000b;padding:30px 28px;position:relative;backdrop-filter:blur(22px)}
.panel:before{content:"";position:absolute;inset:0;border-radius:inherit;background:radial-gradient(ellipse at 50% -8%,#57d8ff22,transparent 55%);pointer-events:none}
.eyebrow{font-weight:850;font-size:11px;letter-spacing:.34em;color:#86f6ff}.logo{font-size:clamp(42px,9vw,76px);line-height:1.04;font-weight:1000;letter-spacing:-.075em;margin:14px 0 5px;background:linear-gradient(110deg,#eaffff 15%,#79f9ff 43%,#fff1bb 66%,#95b5ff 90%);color:transparent;background-clip:text;filter:drop-shadow(0 0 16px #29d8ff55)}.subtitle{font-size:14px;letter-spacing:.28em;font-weight:800;color:#a6d2eb;margin:0 0 25px}.lede{color:#d1e7f4;line-height:1.65;font-size:15px;max-width:430px;margin:0 auto 24px}
.primary{border:0;border-radius:16px;padding:15px 28px;background:linear-gradient(110deg,#39def1,#89f9ff 52%,#a9c2ff);color:#03223b;font-weight:950;letter-spacing:.1em;box-shadow:0 6px 28px #36e8ff50;transition:transform .15s,filter .15s}.primary:hover{transform:translateY(-2px);filter:brightness(1.1)}.secondary{border:1px solid #8cdcf27a;background:#10324a7d;color:#e4faff;border-radius:13px;padding:11px 18px;font-weight:760}.secondary:hover{background:#1a526c}
.actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:20px 0}.how{font-size:12px;line-height:1.75;color:#b8d4e6;margin:19px 0 4px}.key{font-family:monospace;padding:3px 7px;border:1px solid #87aab577;border-radius:5px;background:#12334b;color:#e4fcff;white-space:nowrap}.fine{font-size:11px;color:#8eb7cb;line-height:1.55}
#upgradeChoices{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px;margin-top:24px}.upgrade{border:1px solid #66cced5b;background:linear-gradient(160deg,#11395e,#0b2041);border-radius:15px;min-height:160px;padding:15px 10px;color:#ecfaff;text-align:center;transition:transform .15s,box-shadow .15s}.upgrade:hover{transform:translateY(-5px);box-shadow:0 0 28px #2bdcff3c}.upgrade .glyph{font-size:36px;display:block;margin-bottom:12px}.upgrade strong{font-size:13px;display:block}.upgrade small{display:block;color:#a5cddd;margin-top:10px;line-height:1.5}
#touch{display:none;position:fixed;inset:0;pointer-events:none;z-index:4}#stickZone{position:absolute;bottom:max(28px,env(safe-area-inset-bottom));left:24px;width:156px;height:156px;pointer-events:auto;touch-action:none}#stickBase{position:absolute;inset:13px;border-radius:100%;border:2px solid #8afaff70;background:radial-gradient(circle,#35d5ff24,#0c3f5b50);box-shadow:0 0 24px #00eeff24,inset 0 0 25px #21d7ff24}#stickKnob{position:absolute;left:53px;top:53px;width:50px;height:50px;border-radius:50%;border:2px solid #a1ffffb3;background:radial-gradient(circle at 38% 30%,#bcffffa6,#2badddb3 60%,#21638ac9);box-shadow:0 0 22px #48ffff88;transform:translate(0,0)}
#touchActions{position:absolute;right:20px;bottom:max(30px,env(safe-area-inset-bottom));display:flex;align-items:end;gap:13px;pointer-events:auto} .round-btn{border:2px solid #baffff91;border-radius:50%;width:77px;height:77px;background:radial-gradient(circle at 32% 23%,#42ddffb8,#07547bbb);box-shadow:0 0 35px #2ee7ff55;color:white;font-size:26px;font-weight:900;touch-action:none}.round-btn.special{width:91px;height:91px;border-color:#ffe79daa;background:radial-gradient(circle at 30% 25%,#ffdc80d9,#a5469eb3 76%);box-shadow:0 0 40px #ffac8955}.round-btn:disabled{opacity:.38;filter:grayscale(.75)}
#toast{position:fixed;left:50%;top:22%;transform:translateX(-50%);z-index:6;font-weight:1000;font-size:clamp(20px,5vw,38px);letter-spacing:.07em;text-shadow:0 0 25px #00eeff,0 3px 15px #001;pointer-events:none;opacity:0;text-align:center;white-space:nowrap}
#credit{position:fixed;bottom:8px;left:50%;transform:translateX(-50%);z-index:2;font-size:10px;color:#7caac29a;white-space:nowrap;pointer-events:none}
@media(pointer:coarse){#touch.active{display:block}#credit{display:none}}@media(max-width:640px){.panel{padding:24px 18px}.logo{font-size:50px}.hud-card{padding:8px 9px}.hud-title{font-size:11px}.meter{width:125px}.stats{gap:7px;font-size:10px}#combo{top:89px;right:12px}#upgradeChoices{grid-template-columns:1fr}.upgrade{min-height:85px;display:grid;grid-template-columns:48px 1fr;align-items:center;text-align:left;gap:3px 12px;padding:10px 14px}.upgrade .glyph{grid-row:span 2;margin:0}.upgrade small{margin:0}#stickZone{left:6px;bottom:8px}#touchActions{right:12px;bottom:17px}.round-btn{width:67px;height:67px}.round-btn.special{width:78px;height:78px}}
@media(max-height:530px){.panel{padding:16px 22px}.logo{font-size:39px;margin:5px}.subtitle{margin-bottom:9px}.lede{margin-bottom:9px}.how{margin:9px 0}.round-btn{width:64px;height:64px}.round-btn.special{width:72px;height:72px}#stickZone{bottom:0}} 
</style>
</head>
<body>
<canvas id="game" aria-label="TIDEBREAK game arena. Move with arrow keys or WASD. Auto-attack enemies and press space for a tide blast."></canvas><div id="glow"></div>
<header id="hud"><div class="hud-card"><div class="hud-name">✦ TIDEBREAK <span id="waveLabel">WAVE 1</span></div><div class="hud-title" id="lifeLabel">100 / 100 HP</div><div class="meter"><div id="hpFill"></div></div><div class="meter xp-meter"><div id="xpFill"></div></div></div><div class="hud-card stats"><div class="stat">✦ <span id="levelLabel">1</span> LVL</div><div class="stat">◈ <span id="scoreLabel">0</span></div><div class="stat">⚡ <span id="killsLabel">0</span></div></div><button id="pauseBtn" aria-label="Pause game">Ⅱ</button></header>
<div id="combo"></div><div id="toast" aria-live="polite"></div><div id="credit">MOVE ← ↑ → ↓ / WASD · AIM WITH MOUSE · SPACE = TIDE BLAST · P = PAUSE</div>
<div id="touch"><div id="stickZone" aria-label="Movement joystick"><div id="stickBase"></div><div id="stickKnob"></div></div><div id="touchActions"><button class="round-btn" id="dashTouch" aria-label="Dash">➤</button><button class="round-btn special" id="blastTouch" aria-label="Tide blast">✦</button></div></div>
<div class="screen" id="menu"><section class="panel"><div class="eyebrow">AN ORIGINAL NEON OCEAN ADVENTURE</div><h1 class="logo">TIDEBREAK</h1><p class="subtitle">NEON TIDES ✦</p><p class="lede">The deep has awakened. Pilot your glowing tide guardian, dodge the swarm, and turn every wave into a burst of starlight.</p><button class="primary" id="startBtn">✦ ENTER THE TIDE</button><div class="actions"><button class="secondary" id="soundBtn">♫ SOUND: ON</button><button class="secondary" id="donateBtn" hidden>♡ LEAVE A TIP</button></div><div class="how"><b>DESKTOP:</b> <span class="key">W A S D</span> or <span class="key">← ↑ → ↓</span> to move · Mouse to aim · <span class="key">SPACE</span> blast · <span class="key">SHIFT</span> dash<br><b>PHONE:</b> Drag the glowing joystick · Tap ✦ to blast · Tap ➤ to dash<br>Your guardian automatically fires at approaching creatures.</div><p class="fine">Free to play. No account, no tracking, no pay-to-win. Progress record saved on this device.</p></section></div>
<div class="screen hidden" id="pauseScreen"><section class="panel"><div class="eyebrow">THE TIDE IS HOLDING</div><h2 class="logo" style="font-size:55px">PAUSED</h2><p class="lede">Even guardians need a moment to breathe.</p><button class="primary" id="resumeBtn">RESUME THE BATTLE</button><div class="actions"><button class="secondary" id="restartPauseBtn">RESTART RUN</button><button class="secondary" id="soundPauseBtn">♫ TOGGLE SOUND</button></div></section></div>
<div class="screen hidden" id="upgradeScreen"><section class="panel" style="width:min(700px,100%)"><div class="eyebrow">THE OCEAN ANSWERS YOUR CALL</div><h2 class="logo" style="font-size:clamp(33px,7vw,54px)">LEVEL UP ✦</h2><p class="lede" style="margin-bottom:0">Choose one power. Every choice changes the way you fight.</p><div id="upgradeChoices"></div></section></div>
<div class="screen hidden" id="endScreen"><section class="panel"><div class="eyebrow" id="endEyebrow">THE TIDE REMEMBERS</div><h2 class="logo" id="endTitle" style="font-size:clamp(36px,8vw,62px)">WELL FOUGHT</h2><p class="lede" id="endInfo"></p><div class="eyebrow" id="endBest"></div><div class="actions"><button class="primary" id="retryBtn">↻ PLAY AGAIN</button><button class="secondary" id="endHomeBtn">MAIN MENU</button></div><button class="secondary" id="donateEnd" hidden>♡ SUPPORT THE GAME</button></section></div>
<script>
/* ============================================================================
   TIDEBREAK — SINGLE-FILE HTML GAME
   ============================================================================
   WHAT: Original top-down arena survival game rendered with Canvas 2D.
   WHY: GitHub Pages can host this exact file. No asset folders, modules,
        CDN packages, account, API keys, server, or build step are required.
   DEPLOY: Upload as games/tidebreak.html to your PUBLISHED GitHub branch.
           Then open https://amandazirzow.com/games/tidebreak.html
   OPTIONAL: Replace DONATION_URL below with a payment link you own and verify.
   GAME LOOP: update simulation at frame-rate-independent dt, then draw scene.
   SCOPE: Single-player vs procedural AI enemies (not online multiplayer).
   ============================================================================ */
(()=>{'use strict';
  const DONATION_URL=''; // Change ONLY after verifying your destination; blank hides tip controls.
  const SAVE_KEY='tidebreak_neon_tides_v1';
  const $=id=>document.getElementById(id);
  const C=$('game'),ctx=C.getContext('2d',{alpha:false});
  let W=window.innerWidth,H=window.innerHeight,DPR=1;
  const TAU=Math.PI*2,PI=Math.PI;
  const rand=(a,b)=>a+Math.random()*(b-a),clamp=(x,a,b)=>Math.max(a,Math.min(b,x));
  const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);
  const angle=(a,b)=>Math.atan2(b.y-a.y,b.x-a.x);
  const game={mode:'menu',time:0,elapsed:0,wave:1,level:1,xp:0,xpNeed:12,score:0,kills:0,best:0,upgrades:0,spawnTimer:0,waveClock:0,shake:0,flash:0,combo:0,comboTimer:0,bossSpawned:false};
  let player,enemies=[],shots=[],enemyShots=[],particles=[],pickups=[],rings=[],scenery=[],sparks=[];
  let keys=new Set(),pointer={x:0,y:0,active:false},joystick={x:0,y:0,id:null};
  let soundOn=true,audio=null,toastTimer=0,prev=performance.now(),uiTick=0;
  try{const saved=JSON.parse(localStorage.getItem(SAVE_KEY)||'{}');game.best=Number(saved.best)||0;soundOn=saved.sound!==false;}catch(e){}
  function save(){try{localStorage.setItem(SAVE_KEY,JSON.stringify({best:game.best,sound:soundOn}));}catch(e){/* privacy settings might block storage; gameplay still works */}}
  /* Resize canvas in DEVICE pixels, and render using CSS pixel coordinates.
     WHY: sharp graphics on Retina phones without changing gameplay movement. */
  function resize(){W=innerWidth;H=innerHeight;DPR=Math.min(devicePixelRatio||1,2);C.width=Math.round(W*DPR);C.height=Math.round(H*DPR);C.style.width=W+'px';C.style.height=H+'px';ctx.setTransform(DPR,0,0,DPR,0,0);makeScenery();}
  addEventListener('resize',resize,{passive:true});
  function makeScenery(){scenery=[];sparks=[];for(let i=0;i<75;i++)scenery.push({x:Math.random()*W,y:Math.random()*H,r:rand(1,3.5),phase:rand(0,TAU),type:Math.random()});for(let i=0;i<75;i++)sparks.push({x:Math.random()*W,y:Math.random()*H,phase:rand(0,TAU),speed:rand(3,15),r:rand(.3,1.6)});}
  function newPlayer(){return{x:W*.5,y:H*.56,r:16,hp:100,maxHp:100,speed:235,damage:16,fireRate:.37,fireTimer:0,projectileSpeed:620,range:660,shotCount:1,blastCooldown:0,dashCooldown:0,dashTime:0,invulnerable:0,orbit:0,shield:0,magnet:100,regen:0,angle:-PI/2,trail:[],crit:.1};}
  function begin(){player=newPlayer();enemies=[];shots=[];enemyShots=[];particles=[];pickups=[];rings=[];Object.assign(game,{mode:'playing',elapsed:0,wave:1,level:1,xp:0,xpNeed:12,score:0,kills:0,upgrades:0,spawnTimer:.7,waveClock:0,shake:0,flash:0,combo:0,comboTimer:0,bossSpawned:false});pointer.active=false;keys.clear();joystick.x=joystick.y=0;showOnly(null);$('hud').style.display='flex';$('touch').classList.add('active');$('pauseBtn').textContent='Ⅱ';notify('WAVE 1 · THE DEEP STIRS');updateHUD();tone(420,.16,'sine',.045);}
  function showOnly(id){for(const e of document.querySelectorAll('.screen'))e.classList.toggle('hidden',e.id!==id);}
  function menu(){game.mode='menu';$('hud').style.display='none';$('touch').classList.remove('active');showOnly('menu');}
  function pause(){if(game.mode!=='playing')return;game.mode='paused';showOnly('pauseScreen');}
  function resume(){if(game.mode!=='paused')return;game.mode='playing';showOnly(null);prev=performance.now();}
  function end(){game.mode='ended';if(game.score>game.best){game.best=game.score;save();}$('endTitle').textContent=game.wave>=10?'LEGEND OF THE DEEP':'TIDE FALLEN';$('endInfo').textContent=`You reached wave ${game.wave}, defeated ${game.kills} creatures, and earned ${game.score.toLocaleString()} points.`;$('endBest').textContent='PERSONAL BEST: '+game.best.toLocaleString();showOnly('endScreen');tone(195,.45,'triangle',.065);}
  /* Sounds are generated locally via Web Audio; there are no copyrighted files.
     Browsers allow audio only after a gesture, and this function fails safely. */
  function tone(freq,duration,type='sine',volume=.025,slide=0){if(!soundOn)return;try{if(!audio)audio=new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume();let o=audio.createOscillator(),g=audio.createGain(),t=audio.currentTime;o.type=type;o.frequency.setValueAtTime(Math.max(35,freq),t);if(slide)o.frequency.exponentialRampToValueAtTime(Math.max(35,freq+slide),t+duration);g.gain.setValueAtTime(volume,t);g.gain.exponentialRampToValueAtTime(.0001,t+duration);o.connect(g);g.connect(audio.destination);o.start(t);o.stop(t+duration+.01);}catch(e){}}
  function toggleSound(){soundOn=!soundOn;save();$('soundBtn').textContent=soundOn?'♫ SOUND: ON':'♫ SOUND: OFF';}
  function notify(s){let el=$('toast');el.textContent=s;el.style.opacity=1;toastTimer=1.5;}
  function burst(x,y,color,n=12,power=120){for(let i=0;i<n;i++){const a=rand(0,TAU),speed=rand(power*.2,power);particles.push({x,y,vx:Math.cos(a)*speed,vy:Math.sin(a)*speed,r:rand(1.3,4.5),life:rand(.25,.8),maxLife:.8,color});}if(particles.length>420)particles.splice(0,particles.length-420);}
  function ring(x,y,color,radius=16,speed=230){rings.push({x,y,r:radius,speed,alpha:.8,color});}
  /* ENEMIES: each wave scales health and count; every fifth wave has a boss.
     Three roles create strategy: chasers, fast flankers, and ranged shooters. */
  function spawnEnemy(boss=false){if(enemies.length>95)return;let side=Math.floor(rand(0,4)),m=55,x=side===0?-m:side===1?W+m:rand(0,W),y=side===2?-m:side===3?H+m:rand(0,H);let type=boss?'boss':Math.random()<Math.min(.18+game.wave*.015,.35)?'ranged':Math.random()<.35?'swift':'hunter';let hp=(type==='boss'?350:type==='swift'?22:type==='ranged'?35:42)*(1+game.wave*.24);enemies.push({x,y,r:type==='boss'?39:type==='swift'?12:type==='ranged'?17:18,type,hp,maxHp:hp,speed:(type==='boss'?69:type==='swift'?116:type==='ranged'?66:83)*(1+game.wave*.032),damage:type==='boss'?21:12,phase:rand(0,TAU),fire:rand(.8,2),hit:0,trail:[],shootAngle:0});if(boss){notify('⚠ ABYSSAL LEVIATHAN ⚠');ring(x,y,'#ff6cb5',28,220);tone(115,.65,'sawtooth',.07,-50);}}
  function fireShot(){if(!enemies.length)return;let target=null,d=player.range;for(const e of enemies){let v=dist(player,e);if(v<d){d=v;target=e;}}if(!target)return;const base=pointer.active?Math.atan2(pointer.y-player.y,pointer.x-player.x):angle(player,target);player.angle=base;for(let i=0;i<player.shotCount;i++){let spread=(i-(player.shotCount-1)/2)*.17,theta=base+spread;shots.push({x:player.x+Math.cos(theta)*20,y:player.y+Math.sin(theta)*20,vx:Math.cos(theta)*player.projectileSpeed,vy:Math.sin(theta)*player.projectileSpeed,r:5.5,damage:player.damage,life:1.5,pierce:0});}burst(player.x+Math.cos(base)*20,player.y+Math.sin(base)*20,'#a7ffff',3,75);tone(620,.065,'triangle',.011,-180);}
  function blast(){if(game.mode!=='playing'||player.blastCooldown>0)return;player.blastCooldown=8;ring(player.x,player.y,'#89faff',25,630);ring(player.x,player.y,'#cba8ff',10,570);burst(player.x,player.y,'#80eeff',55,450);game.shake=12;game.flash=.16;for(const e of enemies){const d=dist(player,e);if(d<235){hurtEnemy(e,player.damage*3.2);e.x+=((e.x-player.x)/Math.max(d,1))*55;e.y+=((e.y-player.y)/Math.max(d,1))*55;}}enemyShots=enemyShots.filter(s=>dist(s,player)>235);tone(160,.50,'sawtooth',.06,630);}
  function dash(){if(game.mode!=='playing'||player.dashCooldown>0)return;player.dashCooldown=3.8;player.dashTime=.18;player.invulnerable=.33;const v=getMovement();if(Math.hypot(v.x,v.y)<.1){v.x=Math.cos(player.angle);v.y=Math.sin(player.angle);}player.dashDX=v.x;player.dashDY=v.y;burst(player.x,player.y,'#8bdfff',20,170);tone(230,.18,'sine',.035,420);}
  function hurtEnemy(e,damage){if(e.hp<=0)return;const critical=Math.random()<player.crit,amount=damage*(critical?1.7:1);e.hp-=amount;e.hit=.15;floating(e.x,e.y-15,Math.round(amount)+(critical?'!':''),critical?'#fff1a8':'#bbfbff',critical?20:13);burst(e.x,e.y,critical?'#ffe0a3':'#43e6ff',critical?9:4,100);if(e.hp<=0){game.kills++;game.combo++;game.comboTimer=3.2;const pts=(e.type==='boss'?300:30)+Math.min(game.combo,20)*2;game.score+=pts;burst(e.x,e.y,e.type==='boss'?'#ffb9e5':'#94f9ff',e.type==='boss'?65:18,e.type==='boss'?310:150);ring(e.x,e.y,'#72f2ff',8,180);for(let i=0;i<(e.type==='boss'?18:Math.random()<.18?3:1);i++)pickups.push({x:e.x+rand(-20,20),y:e.y+rand(-20,20),r:6,kind:'xp',value:e.type==='boss'?4:3,t:0});if(Math.random()<.055)pickups.push({x:e.x,y:e.y,r:8,kind:'heal',value:15,t:0});tone(e.type==='boss'?100:240,.13,'triangle',.026,e.type==='boss'?-60:130);}}
  function floating(x,y,text,color,size){particles.push({x,y,vx:rand(-20,20),vy:-70,r:0,life:.7,maxLife:.7,color,text,size});}
  function hitPlayer(amount){if(player.invulnerable>0||game.mode!=='playing')return;if(player.shield>0){player.shield--;ring(player.x,player.y,'#ffd88a',20,160);player.invulnerable=.3;return;}player.hp-=amount;player.invulnerable=.6;game.shake=12;game.flash=.25;burst(player.x,player.y,'#ff6e9c',18,150);tone(140,.19,'square',.045,-70);if(player.hp<=0){player.hp=0;burst(player.x,player.y,'#ffb0dc',80,350);end();}}
  function getMovement(){let x=Number(keys.has('ArrowRight')||keys.has('d'))-Number(keys.has('ArrowLeft')||keys.has('a')),y=Number(keys.has('ArrowDown')||keys.has('s'))-Number(keys.has('ArrowUp')||keys.has('w'));x+=joystick.x;y+=joystick.y;let l=Math.hypot(x,y);return{x:l>0?x/Math.max(1,l):0,y:l>0?y/Math.max(1,l):0};}
  function levelUp(){if(game.mode!=='playing')return;game.mode='upgrade';game.level++;game.upgrades++;showOnly('upgradeScreen');const choices=chooseUpgrades();$('upgradeChoices').innerHTML='';choices.forEach(u=>{const b=document.createElement('button');b.className='upgrade';b.innerHTML='<span class="glyph">'+u.icon+'</span><strong>'+u.title+'</strong><small>'+u.desc+'</small>';b.addEventListener('click',()=>{u.apply();$('upgradeScreen').classList.add('hidden');game.mode='playing';prev=performance.now();burst(player.x,player.y,'#fff0ac',24,180);tone(580,.2,'sine',.06,350);notify(u.title.toUpperCase());updateHUD();});$('upgradeChoices').appendChild(b);});tone(650,.37,'sine',.045,440);}
  const upgrades=[
    {icon:'⚔',title:'Prismatic Blades',desc:'+30% projectile damage',apply:()=>player.damage*=1.3},
    {icon:'✦',title:'Rapid Current',desc:'Fire 18% faster',apply:()=>player.fireRate=Math.max(.095,player.fireRate*.82)},
    {icon:'♜',title:'Coral Armor',desc:'+35 maximum health and heal 35',apply:()=>{player.maxHp+=35;player.hp=Math.min(player.maxHp,player.hp+35);}},
    {icon:'➤',title:'Riptide Boots',desc:'Move 15% faster',apply:()=>player.speed*=1.15},
    {icon:'❖',title:'Twin Stars',desc:'Fire one additional projectile',apply:()=>player.shotCount=Math.min(5,player.shotCount+1)},
    {icon:'♡',title:'Healing Waters',desc:'Regenerate 1.2 HP per second',apply:()=>player.regen+=1.2},
    {icon:'◉',title:'Magnetic Tide',desc:'Collect experience from farther away',apply:()=>player.magnet+=100},
    {icon:'☄',title:'Piercing Momentum',desc:'+25% projectile speed and +8% damage',apply:()=>{player.projectileSpeed*=1.25;player.damage*=1.08;}},
    {icon:'✧',title:'Lucky Stars',desc:'+9% critical hit chance',apply:()=>player.crit=Math.min(.75,player.crit+.09)},
    {icon:'⬡',title:'Pearl Shield',desc:'Block your next 2 hits',apply:()=>player.shield+=2}
  ];
  function chooseUpgrades(){let pool=[...upgrades],out=[];for(let i=0;i<3;i++)out.push(pool.splice(Math.floor(Math.random()*pool.length),1)[0]);return out;}
  function update(dt){game.elapsed+=dt;game.time+=dt;game.waveClock+=dt;game.shake=Math.max(0,game.shake-dt*34);game.flash=Math.max(0,game.flash-dt);if(game.comboTimer>0)game.comboTimer-=dt;else game.combo=0;
    player.invulnerable=Math.max(0,player.invulnerable-dt);player.blastCooldown=Math.max(0,player.blastCooldown-dt);player.dashCooldown=Math.max(0,player.dashCooldown-dt);player.dashTime=Math.max(0,player.dashTime-dt);player.fireTimer-=dt;
    let move=getMovement(),speed=player.speed*(player.dashTime>0?3.7:1);if(player.dashTime>0){move.x=player.dashDX;move.y=player.dashDY;}player.x=clamp(player.x+move.x*speed*dt,23,W-23);player.y=clamp(player.y+move.y*speed*dt,90,Math.max(95,H-25));if(Math.hypot(move.x,move.y)>.1){player.trail.push({x:player.x,y:player.y,t:.36});if(Math.random()<.25)burst(player.x,player.y,'#78e5ff',1,45);}player.trail.forEach(t=>t.t-=dt);player.trail=player.trail.filter(t=>t.t>0);player.hp=Math.min(player.maxHp,player.hp+player.regen*dt);
    if(game.waveClock>19){game.waveClock=0;game.wave++;game.bossSpawned=false;notify('WAVE '+game.wave+' · HOLD THE LINE');tone(430,.28,'triangle',.04,390);}
    game.spawnTimer-=dt;if(game.spawnTimer<=0){spawnEnemy();game.spawnTimer=Math.max(.19,1.18-game.wave*.073)*rand(.7,1.2);}if(game.wave%5===0&&!game.bossSpawned&&game.waveClock>3){spawnEnemy(true);game.bossSpawned=true;}
    if(player.fireTimer<=0){fireShot();player.fireTimer=player.fireRate;}
    for(const s of shots){s.x+=s.vx*dt;s.y+=s.vy*dt;s.life-=dt;for(const e of enemies){if(e.hp>0&&Math.hypot(e.x-s.x,e.y-s.y)<e.r+s.r){hurtEnemy(e,s.damage);s.life=0;break;}}}shots=shots.filter(s=>s.life>0&&s.x>-30&&s.x<W+30&&s.y>-30&&s.y<H+30);
    for(const e of enemies){e.hit=Math.max(0,e.hit-dt);e.phase+=dt*3;let d=dist(e,player),theta=angle(e,player);e.shootAngle=theta;if(e.type==='ranged'&&d<250){theta+=PI*.65;}if(e.type==='boss')theta+=Math.sin(e.phase*.6)*.32;e.x+=Math.cos(theta)*e.speed*dt;e.y+=Math.sin(theta)*e.speed*dt;
      if(d<e.r+player.r)hitPlayer(e.damage);if((e.type==='ranged'||e.type==='boss')&&d<650){e.fire-=dt;if(e.fire<=0){const n=e.type==='boss'?5:1;for(let i=0;i<n;i++){const a=angle(e,player)+(i-(n-1)/2)*.19;enemyShots.push({x:e.x,y:e.y,vx:Math.cos(a)*(e.type==='boss'?175:210),vy:Math.sin(a)*(e.type==='boss'?175:210),r:e.type==='boss'?8:6,damage:e.type==='boss'?16:10,life:4});}e.fire=e.type==='boss'?1.8:2.1;burst(e.x,e.y,'#f988e0',7,65);}}}
    enemies=enemies.filter(e=>e.hp>0&&e.x>-200&&e.x<W+200&&e.y>-200&&e.y<H+200);
    for(const s of enemyShots){s.x+=s.vx*dt;s.y+=s.vy*dt;s.life-=dt;if(dist(s,player)<player.r+s.r){hitPlayer(s.damage);s.life=0;}}enemyShots=enemyShots.filter(s=>s.life>0);
    for(const g of pickups){g.t+=dt;const d=dist(g,player);if(d<player.magnet&&d>12){g.x+=(player.x-g.x)/d*Math.min(d,260*dt);g.y+=(player.y-g.y)/d* Math.min(d,260*dt);}if(d<player.r+g.r+8){g.collected=true;if(g.kind==='heal'){player.hp=Math.min(player.maxHp,player.hp+g.value);floating(player.x,player.y-24,'+'+g.value+' HP','#a5ffc4',15);}else{game.xp+=g.value;game.score+=2;}tone(g.kind==='heal'?520:880,.075,'sine',.015,190);}}pickups=pickups.filter(g=>!g.collected);
    if(game.xp>=game.xpNeed){game.xp-=game.xpNeed;game.xpNeed=Math.floor(game.xpNeed*1.26+6);levelUp();}
    updateFx(dt);uiTick-=dt;if(uiTick<=0){updateHUD();uiTick=.1;}
  }
  function updateFx(dt){for(const p of particles){p.x+=p.vx*dt;p.y+=p.vy*dt;p.vx*=Math.pow(.18,dt);p.vy*=Math.pow(.18,dt);p.life-=dt;}particles=particles.filter(p=>p.life>0);for(const r of rings){r.r+=r.speed*dt;r.alpha-=dt*1.5;}rings=rings.filter(r=>r.alpha>0);if(toastTimer>0){toastTimer-=dt;$('toast').style.opacity=String(Math.min(1,toastTimer*2));}}
  function updateHUD(){if(!player)return;$('waveLabel').textContent=' · WAVE '+game.wave;$('lifeLabel').textContent=Math.ceil(player.hp)+' / '+Math.ceil(player.maxHp)+' HP';$('hpFill').style.width=clamp(player.hp/player.maxHp*100,0,100)+'%';$('xpFill').style.width=clamp(game.xp/game.xpNeed*100,0,100)+'%';$('levelLabel').textContent=game.level;$('scoreLabel').textContent=game.score.toLocaleString();$('killsLabel').textContent=game.kills;$('combo').textContent=game.combo>=4&&game.comboTimer>0?'✦ '+game.combo+' COMBO!':'';$('blastTouch').disabled=player.blastCooldown>0;$('blastTouch').textContent=player.blastCooldown>0?Math.ceil(player.blastCooldown):'✦';$('dashTouch').disabled=player.dashCooldown>0;$('dashTouch').textContent=player.dashCooldown>0?Math.ceil(player.dashCooldown):'➤';}
  /* DRAW: layered water, moving luminous contour lines, plankton, coral-like
     filigree, glowing pickups, enemies, projectiles and the player's guardian.
     All graphics are procedural Canvas drawings (no external image requests). */
  function glow(x,y,r,color,alpha=1){const g=ctx.createRadialGradient(x,y,0,x,y,r);g.addColorStop(0,color);g.addColorStop(1,'transparent');ctx.globalAlpha=alpha;ctx.fillStyle=g;ctx.beginPath();ctx.arc(x,y,r,0,TAU);ctx.fill();ctx.globalAlpha=1;}
  function circle(x,y,r,fill,stroke='',sw=1){ctx.beginPath();ctx.arc(x,y,Math.max(.01,r),0,TAU);ctx.fillStyle=fill;ctx.fill();if(stroke){ctx.lineWidth=sw;ctx.strokeStyle=stroke;ctx.stroke();}}
  function polygon(x,y,r,n,rotation,fill,stroke='',width=1){ctx.beginPath();for(let i=0;i<n;i++){let a=rotation+i*TAU/n;const px=x+Math.cos(a)*r,py=y+Math.sin(a)*r;i?ctx.lineTo(px,py):ctx.moveTo(px,py);}ctx.closePath();ctx.fillStyle=fill;ctx.fill();if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=width;ctx.stroke();}}
  function water(t){const grad=ctx.createLinearGradient(0,0,W,H);grad.addColorStop(0,'#05102c');grad.addColorStop(.5,'#062642');grad.addColorStop(1,'#03112c');ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);
    glow(W*.28,H*.23,Math.max(150,W*.55),'#076d8c',.28);glow(W*.8,H*.79,Math.max(120,W*.36),'#4643b1',.24);
    ctx.save();ctx.strokeStyle='#60e7ff';ctx.lineWidth=1;for(let j=0;j<17;j++){let y=j*57+(t*9)%57-40;ctx.beginPath();for(let x=-25;x<W+25;x+=13){const py=y+Math.sin(x*.014+t*.65+j*.5)*8+Math.sin(x*.032-t*.7+j)*3;x===-25?ctx.moveTo(x,py):ctx.lineTo(x,py);}ctx.globalAlpha=.017+(j%4===0?.032:0);ctx.stroke();}ctx.restore();
    for(const s of scenery){let pulse=(Math.sin(t*1.65+s.phase)+1)/2;ctx.globalAlpha=.1+pulse*.33;circle(s.x,s.y,s.r*(.5+pulse*.7),s.type>.5?'#8dfbff':'#f0cdff');}ctx.globalAlpha=1;
    for(const s of sparks){s.y+=.007*s.speed;s.x+=Math.sin(t*.5+s.phase)*.02;if(s.y>H)s.y=0;circle(s.x,s.y,s.r,'#85ddff88');}
    /* Translucent crystalline corals stay around screen edges and never block play. */
    ctx.save();for(let side=0;side<2;side++){let bx=side===0?0:W;for(let k=0;k<5;k++){let by=H*(k+.5)/5,off=side===0?1:-1;ctx.strokeStyle=k%2?'#4489cf24':'#4fffff27';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(bx,by+24);ctx.quadraticCurveTo(bx+off*60,by-35,bx+off*(35+12*Math.sin(t*.5+k)),by-74);ctx.moveTo(bx+off*23,by-10);ctx.lineTo(bx+off*70,by-38);ctx.stroke();glow(bx+off*40,by-52,26,'#17a5c1',.11);}}ctx.restore();
  }
  function drawPlayer(t){if(!player)return;for(const p of player.trail){glow(p.x,p.y,35,'#39eaff',p.t*.27);circle(p.x,p.y,player.r*p.t/.36,'#48ffff44');}ctx.save();ctx.translate(player.x,player.y);ctx.rotate(player.angle+PI/2);let flashing=player.invulnerable>0&&Math.sin(t*35)>0;
    glow(0,0,58,'#26f7ff',.27);ctx.rotate(Math.sin(t*3)*.04);
    /* Three fin blades form a stylized manta/guardian silhouette. */
    ctx.fillStyle=flashing?'#ffffff':'#49dffe';ctx.shadowColor='#6bfaff';ctx.shadowBlur=25;ctx.beginPath();ctx.moveTo(0,-23);ctx.bezierCurveTo(-8,-11,-17,-6,-31,5);ctx.bezierCurveTo(-13,8,-12,20,0,15);ctx.bezierCurveTo(12,20,13,8,31,5);ctx.bezierCurveTo(17,-6,8,-11,0,-23);ctx.fill();ctx.shadowBlur=0;
    polygon(0,0,13,6,t*.6,'#f0fcff','#72ffff',2);glow(0,0,20,'#fff3c1',.6);circle(0,0,5,'#fff6ce');circle(-12,2,2.4,'#09365d');circle(12,2,2.4,'#09365d');ctx.restore();
    /* Rotating orbit and shield, visible as earned defensive effects. */
    if(player.shield>0){ctx.strokeStyle='#f9dda2bb';ctx.lineWidth=2;ctx.beginPath();ctx.arc(player.x,player.y,30+Math.sin(t*5)*3,0,TAU);ctx.stroke();for(let i=0;i<player.shield;i++){let a=t*1.7+i*TAU/player.shield;glow(player.x+Math.cos(a)*31,player.y+Math.sin(a)*31,15,'#ffdf88',.65);}}
    if(player.hp<player.maxHp){ctx.fillStyle='#08192dbb';ctx.fillRect(player.x-21,player.y+26,42,5);ctx.fillStyle='#69ffe1';ctx.fillRect(player.x-21,player.y+26,42*player.hp/player.maxHp,5);}
  }
  function drawEnemy(e,t){let a=t*2+e.phase;let palette=e.type==='boss'?['#ff61c4','#ffe1fc']:e.type==='ranged'?['#bd82ff','#e9c4ff']:e.type==='swift'?['#ffb45a','#fff0b3']:['#ff6f9d','#ffc0d6'];glow(e.x,e.y,e.r*2.9,palette[0],.25);ctx.save();ctx.translate(e.x,e.y);ctx.rotate(a*.25);if(e.type==='boss'){polygon(0,0,e.r+7,8,PI/8,'#4c1d61',palette[0],3);polygon(0,0,e.r*.66,8,-a,'#b83e8f',palette[1],2);for(let i=0;i<8;i++){let q=i*TAU/8+a*.16;circle(Math.cos(q)*(e.r+9),Math.sin(q)*(e.r+9),4,palette[1]);}}
    else if(e.type==='swift'){polygon(0,0,e.r+4,4,PI/4,'#713e44',palette[0],2.5);polygon(0,0,e.r*.62,4,a,'#ffcd91');}
    else if(e.type==='ranged'){polygon(0,0,e.r+2,6,PI/6,'#543980',palette[0],3);circle(0,0,7,palette[1]);for(let i=0;i<3;i++){let q=a+i*TAU/3;circle(Math.cos(q)*e.r*.7,Math.sin(q)*e.r*.7,2,'#fff');}}
    else{polygon(0,0,e.r+3,5,a*.12,'#70294e',palette[0],3);polygon(0,0,e.r*.55,5,-a*.28,palette[0]);}
    circle(0,0,e.type==='boss'?9:4,e.hit>0?'white':palette[1]);ctx.restore();
    if(e.hp<e.maxHp){let width=e.r*2.1;ctx.fillStyle='#070b1ecc';ctx.fillRect(e.x-width/2,e.y-e.r-14,width,4);ctx.fillStyle=palette[0];ctx.fillRect(e.x-width/2,e.y-e.r-14,width*clamp(e.hp/e.maxHp,0,1),4);}}
  function render(t){ctx.setTransform(DPR,0,0,DPR,0,0);ctx.clearRect(0,0,W,H);ctx.save();if(game.shake>0&&game.mode==='playing')ctx.translate(rand(-game.shake,game.shake),rand(-game.shake,game.shake));water(t);
    if(game.mode==='menu'){/* Attractive ambient guardian and drifting motes behind opening menu. */const x=W*.5+Math.sin(t*.5)*95,y=H*.62+Math.cos(t*.35)*35;glow(x,y,130,'#29faff',.29);for(let i=0;i<9;i++){let q=t*.24+i*TAU/9;circle(x+Math.cos(q)*(75+i*9),y+Math.sin(q)*(55+i*8),3+(i%3),'#90eeff99');}polygon(x,y,32,6,t*.6,'#1c6984','#82faff',4);polygon(x,y,18,6,-t,'#c1faff');}
    for(const g of pickups){let q=t*4+g.t;glow(g.x,g.y,28,g.kind==='heal'?'#77ffc3':'#9b8bff',.4);polygon(g.x,g.y,g.r+Math.sin(q)*1.5,4,PI/4+q*.18,g.kind==='heal'?'#a2ffd4':'#d5b8ff','#ffffff',1);}
    for(const r of rings){ctx.globalAlpha=r.alpha;ctx.strokeStyle=r.color;ctx.lineWidth=3;ctx.beginPath();ctx.arc(r.x,r.y,r.r,0,TAU);ctx.stroke();}ctx.globalAlpha=1;
    for(const e of enemies)drawEnemy(e,t);
    for(const s of enemyShots){glow(s.x,s.y,23,'#ff8cb7',.5);circle(s.x,s.y,s.r,'#ffa4d3','#fff0f8',1.5);}
    for(const s of shots){glow(s.x,s.y,25,'#71eaff',.4);circle(s.x,s.y,s.r,'#d8ffff','#79faff',2);}
    drawPlayer(t);
    for(const p of particles){ctx.globalAlpha=clamp(p.life/(p.maxLife||1),0,1);if(p.text){ctx.font='900 '+p.size+'px system-ui';ctx.textAlign='center';ctx.fillStyle=p.color;ctx.shadowBlur=8;ctx.shadowColor=p.color;ctx.fillText(p.text,p.x,p.y);}else{glow(p.x,p.y,p.r*4,p.color,.28);circle(p.x,p.y,p.r,p.color);}}ctx.globalAlpha=1;ctx.shadowBlur=0;
    if(game.mode==='playing'&&player){/* Compact cooldown and ability text under character */const ready=player.blastCooldown<=0;ctx.font='bold 10px system-ui';ctx.textAlign='center';ctx.fillStyle=ready?'#b2fff5aa':'#9bb7cc88';ctx.fillText(ready?'✦ TIDE BLAST READY':'✦ '+player.blastCooldown.toFixed(1)+'s',player.x,player.y+48);}
    if(game.flash>0){ctx.fillStyle='rgba(250,165,200,'+(game.flash*.22)+')';ctx.fillRect(0,0,W,H);}ctx.restore();}
  function frame(now){let dt=Math.min((now-prev)/1000,.035);prev=now;game.time+=game.mode==='playing'?0:dt;if(game.mode==='playing')update(dt);else updateFx(dt);render(game.time);requestAnimationFrame(frame);}
  /* INPUTS: keyboard movement and on-screen joystick feed the SAME vector.
     Browser arrow-key scrolling is prevented only for gameplay key bindings. */
  addEventListener('keydown',e=>{const key=e.key.length===1?e.key.toLowerCase():e.key;if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' ','Shift'].includes(e.key))e.preventDefault();keys.add(key);if(e.repeat)return;if(key===' '||key==='Enter'&&game.mode==='playing')blast();if(key==='Shift')dash();if(key==='p'||key==='Escape'){if(game.mode==='playing')pause();else if(game.mode==='paused')resume();}});
  addEventListener('keyup',e=>keys.delete(e.key.length===1?e.key.toLowerCase():e.key));addEventListener('blur',()=>{keys.clear();joystick.x=joystick.y=0;if(game.mode==='playing')pause();});
  C.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'){pointer.x=e.clientX;pointer.y=e.clientY;pointer.active=true;}});C.addEventListener('pointerdown',e=>{if(e.pointerType==='mouse'&&game.mode==='playing'){pointer.x=e.clientX;pointer.y=e.clientY;pointer.active=true;}});
  const zone=$('stickZone'),knob=$('stickKnob');function moveStick(e){const rect=zone.getBoundingClientRect(),cx=rect.left+rect.width/2,cy=rect.top+rect.height/2,dx=e.clientX-cx,dy=e.clientY-cy,l=Math.hypot(dx,dy),a=Math.min(1,l/49);joystick.x=l?dx/l*a:0;joystick.y=l?dy/l*a:0;knob.style.transform=`translate(${joystick.x*49}px,${joystick.y*49}px)`;}
  zone.addEventListener('pointerdown',e=>{if(game.mode!=='playing')return;joystick.id=e.pointerId;zone.setPointerCapture(e.pointerId);moveStick(e);e.preventDefault();});zone.addEventListener('pointermove',e=>{if(joystick.id===e.pointerId)moveStick(e);});const stopStick=e=>{if(joystick.id!==e.pointerId)return;joystick.id=null;joystick.x=joystick.y=0;knob.style.transform='translate(0,0)';};zone.addEventListener('pointerup',stopStick);zone.addEventListener('pointercancel',stopStick);
  $('blastTouch').addEventListener('pointerdown',e=>{e.preventDefault();blast();});$('dashTouch').addEventListener('pointerdown',e=>{e.preventDefault();dash();});
  $('startBtn').onclick=begin;$('retryBtn').onclick=begin;$('restartPauseBtn').onclick=begin;$('endHomeBtn').onclick=menu;$('pauseBtn').onclick=pause;$('resumeBtn').onclick=resume;$('soundBtn').onclick=toggleSound;$('soundPauseBtn').onclick=toggleSound;
  if(DONATION_URL){for(const id of ['donateBtn','donateEnd']){$(id).hidden=false;$(id).onclick=()=>window.open(DONATION_URL,'_blank','noopener,noreferrer');}}
  $('soundBtn').textContent=soundOn?'♫ SOUND: ON':'♫ SOUND: OFF';
  resize();requestAnimationFrame(frame);
})();
