function renderSquare(q){const area=$('answerArea');area.replaceChildren();const info=document.createElement('p');info.className='muted';info.textContent='1. Choose a genotype below.  2. Tap a blank square to place it.  3. Fill all squares.';area.append(info);const panel=document.createElement('div');panel.className='punnett';const grid=document.createElement('div');grid.className='sq';grid.style.setProperty('--n',q.top.length);const corner=document.createElement('div');corner.className='sqcell sqcorner';corner.textContent='×';grid.append(corner);for(const t of q.top){const cell=document.createElement('div');cell.className='sqcell sqhead';cell.textContent=t;grid.append(cell)}state.grid=Array(q.cells.length).fill(null);q.side.forEach((allele,r)=>{const side=document.createElement('div');side.className='sqcell sqhead';side.textContent=allele;grid.append(side);q.top.forEach((_,c)=>{const idx=r*q.top.length+c;const box=document.createElement('button');box.type='button';box.className='sqcell blank';box.dataset.square=idx;box.setAttribute('aria-label','Offspring cell row '+(r+1)+' column '+(c+1));box.textContent='?';box.addEventListener('click',()=>{if(state.done)return;if(state.palette===null){toast('Choose a genotype first!');return}state.grid[idx]=state.palette;box.textContent=state.palette;box.classList.add('fill');box.classList.remove('blank');sound(370+idx*60,.07);$('checkBtn').disabled=state.grid.some(v=>v===null)});grid.append(box)})});panel.append(grid);area.append(panel);const palette=document.createElement('div');palette.className='choices';palette.setAttribute('aria-label','Genotype choices');for(const item of q.palette){const b=document.createElement('button');b.type='button';b.className='allele';b.textContent=item;b.setAttribute('aria-pressed','false');b.addEventListener('click',()=>{state.palette=item;palette.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));sound(400,.06)});palette.append(b)}area.append(palette);const sub=document.createElement('div');sub.className='confnote';sub.textContent='Tip: choose another genotype anytime, then tap a filled square to change it.';area.append(sub)}
function showHint(){if(state.done||state.usedHint)return;state.usedHint=true;state.hints++;$('hintArea').textContent='💡 '+QUESTIONS[state.index].hint;$('hintArea').classList.remove('hidden');$('hintBtn').disabled=true;$('multiplier').textContent='−25 HINT PENALTY';updateStats();sound(280,.12)}
function showFeedback(correct,q,final){const area=$('feedbackArea');area.className='feedback '+(correct?'good':'bad');area.replaceChildren();const title=document.createElement('strong');title.textContent=correct?(state.tries===0?'✨ Brilliant! Correct answer.':'✅ You solved it!'):(final?'🧠 Here’s how it works:':'Not quite — give it another shot!');const body=document.createElement('span');body.textContent=final||correct?q.explain:'Think through each allele combination, then try again.';area.append(title,body);}
function check(){if(state.done)return;const q=QUESTIONS[state.index];const correct=q.type==='mc'?state.selected===q.answer:state.grid.length===q.cells.length&&state.grid.every((a,i)=>a===q.cells[i]);if(correct){const gain=Math.max(35,MAX_POINTS_PER_QUESTION-(state.usedHint?25:0)-(state.tries*20));state.score+=gain;state.correct++;state.streak++;state.done=true;state.log.push(record(q,true,gain));showFeedback(true,q,true);$('multiplier').textContent='+'+gain+' POINTS';chime();if(state.streak%3===0){toast('🔥 '+state.streak+' IN A ROW!');confetti(28)}else confetti(12);finishQuestionControls();if(q.type==='mc')paintCorrectAnswer(q);else paintSquare(q);}else{state.tries++;state.wrong++;state.streak=0;sound(170,.24,'triangle');showFeedback(false,q,state.tries>=2);$('questionCard').classList.remove('shake');void $('questionCard').offsetWidth;$('questionCard').classList.add('shake');if(state.tries>=2){state.done=true;state.log.push(record(q,false,0));$('multiplier').textContent='+0 POINTS';finishQuestionControls();if(q.type==='mc')paintCorrectAnswer(q);else paintSquare(q)}else toast('One more try! You can figure it out.')}updateStats()}
function paintCorrectAnswer(q){$('answerArea').querySelectorAll('.answer').forEach((b,i)=>{b.disabled=state.done;b.classList.toggle('correct',i===q.answer);b.classList.toggle('incorrect',state.selected===i&&i!==q.answer)})}
function paintSquare(q){$('answerArea').querySelectorAll('[data-square]').forEach((b,i)=>{b.disabled=true;const was=state.grid[i];b.textContent=q.cells[i];b.className='sqcell '+(was===q.cells[i]?'fill':'sqhead');b.title=was===q.cells[i]?'Correct':'Correct genotype: '+q.cells[i]});$('answerArea').querySelectorAll('.allele').forEach(b=>b.disabled=true)}
function record(q,correct,points){return {question:state.index+1,mission:MISSIONS[q.mission].name,prompt:q.title,correct,points,hint:state.usedHint,tries:state.tries}}
function finishQuestionControls(){$('checkBtn').classList.add('hidden');$('nextBtn').classList.remove('hidden');$('nextBtn').textContent=state.index===QUESTIONS.length-1?'SEE MY RESULTS 🏆':'NEXT CHALLENGE →';$('hintBtn').classList.add('hidden');$('skipBtn').classList.add('hidden')}
function advance(){if(!state.done)return;state.index++;if(state.index>=QUESTIONS.length){endGame();return}if(QUESTIONS[state.index].mission!==QUESTIONS[state.index-1].mission){confetti(60);openLesson(QUESTIONS[state.index].mission,false);toast('MISSION COMPLETE! '+MISSIONS[QUESTIONS[state.index].mission].icon)}else renderQuestion();window.scrollTo({top:0,behavior:'smooth'})}
function skip(){if(state.done)return;const q=QUESTIONS[state.index];state.streak=0;state.done=true;state.log.push(record(q,false,0));showFeedback(false,q,true);$('multiplier').textContent='+0 POINTS';finishQuestionControls();if(q.type==='mc')paintCorrectAnswer(q);else paintSquare(q);updateStats()}
function localAttempts(){try{return JSON.parse(localStorage.getItem(STORAGE_KEY)||'[]')}catch(e){return []}}
function updateRecord(){const a=localAttempts();const high=a.length?Math.max(...a.map(x=>Number(x.score)||0)):null;$('localRecord').textContent=high===null?'No completed attempts on this device yet.':'Best score on this device: '+high.toLocaleString()+' / '+(QUESTIONS.length*100)+'. '+a.length+' completed attempt(s).'}
function saveAttempt(payload){try{const arr=localAttempts();arr.push({name:payload.name,score:payload.score,correct:payload.correct,finishedAt:payload.finishedAt});localStorage.setItem(STORAGE_KEY,JSON.stringify(arr.slice(-50)));return true}catch(e){return false}}
function resultPayload(){return {version:GAME_VERSION,attemptId:state.attemptId,name:state.player.name,firstName:state.player.firstName,lastName:state.player.lastName,leaderboardOptIn:state.player.leaderboardOptIn,email:state.player.email,emailOptIn:state.player.emailOptIn,score:state.score,maxScore:QUESTIONS.length*100,correct:state.correct,total:QUESTIONS.length,accuracy:Math.round(state.correct/QUESTIONS.length*100),hints:state.hints,wrongAttempts:state.wrong,seconds:Math.floor((Date.now()-state.startTime)/1000),finishedAt:new Date().toISOString(),answers:state.log};}
function endGame(){state.attemptId='GQ-'+Date.now()+'-'+Math.random().toString(36).slice(2,9);state.index=QUESTIONS.length;$('progressFill').style.width='100%';const percent=Math.round(state.correct/QUESTIONS.length*100);$('resultTitle').textContent=percent>=88?'GENETICS LEGEND!':percent>=68?'GENETICS EXPLORER!':'GENETICS APPRENTICE!';$('resultMessage').textContent=state.player.name+', you completed all '+QUESTIONS.length+' genetics challenges. Every mistake is a new clue!';$('resultScore').textContent=state.score.toLocaleString();$('resultMax').textContent='out of '+(QUESTIONS.length*100).toLocaleString()+' possible points';$('resultAccuracy').textContent=percent+'%';$('resultCount').textContent=state.correct+' of '+QUESTIONS.length+' challenges completed correctly';$('leaderboardOutcome').textContent=state.player.leaderboardOptIn?'🏆 You opted in: your first name and last initial can appear on the public leaderboard once your score is received.':'🔒 You did not opt into the leaderboard. Your score is not included in the public leaderboard.';show('endScreen');const payload=resultPayload();saveAttempt(payload);updateRecord();confetti(95);chime();submitScore(payload)}
async function submitScore(payload){const el=$('submissionStatus');if(!SCORE_ENDPOINT){el.textContent='📍 Practice mode: Your score is saved on this device only. Online score collection is not yet configured by the site owner. Download your report below as backup.';return}el.textContent='📡 Attempting to send your result to the site owner’s results Sheet…';try{const response=await fetch(SCORE_ENDPOINT,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(payload),keepalive:true});el.textContent='📤 Score submission sent to the configured endpoint. Because Google Apps Script does not expose a readable cross-origin response, delivery CANNOT be verified here. Download your report as backup and ask the site owner to confirm the Sheet entry if needed.'}catch(e){el.textContent='⚠️ Online submission could not be sent from this browser. Your result is still saved on this device. Download the report and keep it for your records.'}}
/* ============================================================================
   PUBLIC LEADERBOARD — data comes from a READ-ONLY Google Apps Script doGet.
   Apps Script redirects requests and often does not supply CORS headers. We
   use JSONP for this public, deliberately minimal dataset ONLY. Never return
   private student records or email addresses from doGet. The configured script
   URL must be controlled by the instructor.
   ============================================================================ */
let leaderboardLoading=false;
function drawLeaderboard(rows){
 const root=$('leaderboardTable');root.replaceChildren();
 if(!Array.isArray(rows)||!rows.length){root.textContent='No opted-in scores yet. Be the first!';return}
 const table=document.createElement('table');table.className='leaderboard';
 const head=document.createElement('thead'),hr=document.createElement('tr');
 for(const label of ['#','Player','Score','Date']){const th=document.createElement('th');th.textContent=label;hr.append(th)}
 head.append(hr);table.append(head);
 const body=document.createElement('tbody');
 rows.slice(0,20).forEach((item,i)=>{
  const tr=document.createElement('tr');
  const fields=[String(i+1),String(item.player||''),Number(item.score||0).toLocaleString(),String(item.date||'')];
  for(const field of fields){const td=document.createElement('td');td.textContent=field;tr.append(td)}
  body.append(tr);
 });
 table.append(body);root.append(table);
}
function refreshLeaderboard(){
 const root=$('leaderboardTable');
 if(!SCORE_ENDPOINT){root.textContent='Leaderboard is inactive until the instructor connects the Google Sheets endpoint.';return}
 if(leaderboardLoading)return;
 leaderboardLoading=true;root.textContent='Loading public leaderboard…';
 // The callback name is fixed so Apps Script can validate it. A timeout prevents a stuck spinner.
 const callback='__geneticsQuestLeaderboard';
 let script=document.createElement('script'),finished=false;
 const timeout=setTimeout(()=>finish(false),10000);
 function finish(ok){if(finished)return;finished=true;clearTimeout(timeout);leaderboardLoading=false;script.remove();delete window[callback];if(!ok)root.textContent='Unable to load leaderboard. Try refresh or ask your instructor to check the deployment.'}
 window[callback]=function(data){if(data&&data.ok&&Array.isArray(data.rows)){drawLeaderboard(data.rows);finish(true)}else finish(false)};
 script.onerror=()=>finish(false);
 script.src=SCORE_ENDPOINT+(SCORE_ENDPOINT.includes('?')?'&':'?')+'action=leaderboard&callback='+callback+'&_='+Date.now();
 document.head.append(script);
}
function downloadReport(){if(!state.player)return;const p=resultPayload();const lines=['GENETICS QUEST — SCORE REPORT','Name: '+p.name,'Email permission: '+(p.emailOptIn?'Yes':'No'),'Completed: '+p.finishedAt,'Attempt ID: '+p.attemptId,'Score: '+p.score+' / '+p.maxScore,'Correct challenges: '+p.correct+' / '+p.total,'Accuracy: '+p.accuracy+'%','Hints used: '+p.hints,'','QUESTION RESULTS',...p.answers.map(a=>'Q'+a.question+' | '+a.mission+' | '+(a.correct?'Correct':'Not correct')+' | '+a.points+' pts | '+a.prompt)];const blob=new Blob([lines.join('\r\n')],{type:'text/plain;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='GeneticsQuest_'+p.name.replace(/[^\w-]/g,'_')+'_'+new Date().toISOString().slice(0,10)+'.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1500);toast('Score report downloaded!')}
function reset(){if(state.player&&state.index<QUESTIONS.length&&state.log.length>0&&!confirm('Restart? Your current unfinished score will be lost.'))return;state.player=null;state.index=0;state.log=[];state.score=0;state.correct=0;state.streak=0;state.hints=0;state.wrong=0;$('studentForm').reset();show('startScreen');updateStats();renderMap();}
$('lessonGoBtn').addEventListener('click',leaveLesson);$('lessonBackBtn').addEventListener('click',leaveLesson);$('reviewLessonBtn').addEventListener('click',()=>openLesson(QUESTIONS[state.index].mission,true));$('refreshLeaderboard').addEventListener('click',refreshLeaderboard);$('studentForm').addEventListener('submit',e=>{e.preventDefault();begin()});$('checkBtn').addEventListener('click',check);$('nextBtn').addEventListener('click',advance);$('hintBtn').addEventListener('click',showHint);$('skipBtn').addEventListener('click',skip);$('resetBtn').addEventListener('click',reset);$('playAgainBtn').addEventListener('click',reset);$('downloadBtn').addEventListener('click',downloadReport);$('howBtn').addEventListener('click',()=>{state.returnScreen=['gameScreen','lessonScreen','endScreen'].find(id=>!$(id).classList.contains('hidden'))||'startScreen';show('helpScreen')});$('backBtn').addEventListener('click',()=>show(state.returnScreen||'startScreen'));$('soundBtn').addEventListener('click',()=>{audioOn=!audioOn;$('soundBtn').textContent=audioOn?'🔊 Sound on':'🔇 Sound off';if(audioOn)sound(620,.12)});updateStats();renderMap();updateRecord();refreshLeaderboard();
