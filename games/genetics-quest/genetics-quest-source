 const RESULTS_TAB = 'Genetics Quest Results';
 function ensureResults_(ss) {
   let sh=ss.getSheetByName(RESULTS_TAB);
   if (!sh) {
     sh=ss.insertSheet(RESULTS_TAB);
     sh.appendRow(['Received at','Attempt ID','First name','Last name',
       'Full name','Email (optional)','Email permission','Score','Max score','Correct',
       'Total','Accuracy (%)','Hints','Incorrect attempts','Duration (s)',
       'Finished at (visitor clock)','Answer details','Leaderboard opt-in']);
     sh.setFrozenRows(1);
   }
   return sh;
 }
 function doPost(e) {
   const lock=LockService.getScriptLock();lock.waitLock(20000);
   try {
     const d=JSON.parse((e.postData&&e.postData.contents)||'{}');
     if (!d.attemptId||!d.firstName||!d.lastName||!Array.isArray(d.answers))
       return ContentService.createTextOutput('Invalid submission');
     const ss=SpreadsheetApp.getActiveSpreadsheet(),sh=ensureResults_(ss);
     const n=sh.getLastRow();
     if(n>1 && sh.getRange(2,2,n-1,1).getValues().flat().includes(String(d.attemptId)))
       return ContentService.createTextOutput('Duplicate ignored');
     // Escape strings that spreadsheets might interpret as formulas.
     function safe(v,max){const t=String(v==null?'':v).slice(0,max);
       return /^[=+\-@]/.test(t)?"'"+t:t}
     const first=safe(d.firstName,50),last=safe(d.lastName,60);
     const details=d.answers.slice(0,100).map(a=>
       [a.question,a.correct?'correct':'incorrect',a.points].join(':')).join(' | ');
     const score=Math.max(0,Math.min(2500,Number(d.score)||0));
     sh.appendRow([new Date(),safe(d.attemptId,80),first,last,
       safe(first+' '+last,110),d.emailOptIn===true?safe(d.email,180):'',d.emailOptIn===true,
       score,Number(d.maxScore)||0,Number(d.correct)||0,Number(d.total)||0,
       Number(d.accuracy)||0,Number(d.hints)||0,Number(d.wrongAttempts)||0,
       Number(d.seconds)||0,safe(d.finishedAt,50),safe(details,3000),
       d.leaderboardOptIn===true]);
     return ContentService.createTextOutput('Recorded');
   }catch(err){return ContentService.createTextOutput('Error');}
   finally{lock.releaseLock()}
 }
 function doGet(e) {
   const cb=String((e.parameter&&e.parameter.callback)||'');
   // Restrict JSONP callback to the fixed name used by this HTML.
   if(cb!=='__geneticsQuestLeaderboard')
     return ContentService.createTextOutput('Invalid callback');
   const ss=SpreadsheetApp.getActiveSpreadsheet(),sh=ensureResults_(ss);
   const n=sh.getLastRow();let rows=[];
   if(n>1){
     const values=sh.getRange(2,1,n-1,18).getValues();
     rows=values.filter(r=>r[17]===true).map(r=>{
       const first=String(r[2]||'').trim().replace(/[^\p{L}\p{M}' -]/gu,'').slice(0,30);
       const initial=String(r[3]||'').trim().charAt(0).toUpperCase().replace(/[^A-Z]/g,'');
       const day=r[0] instanceof Date?Utilities.formatDate(r[0],Session.getScriptTimeZone(),'yyyy-MM-dd'):'';
       return {player:first+' '+(initial?initial+'.':''),score:Number(r[7])||0,date:day};
     }).sort((a,b)=>b.score-a.score||b.date.localeCompare(a.date)).slice(0,20);
   }
   // JSON stringify prevents player text from being interpreted as script code.
   const json=JSON.stringify({ok:true,rows:rows}).replace(/</g,'\\u003c');
   return ContentService.createTextOutput(cb+'('+json+');')
     .setMimeType(ContentService.MimeType.JAVASCRIPT);
 }

